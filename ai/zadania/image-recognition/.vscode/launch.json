    "version": "0.2.0",
    "configurations": [
        {
            "name": "ukazka obrazkov",
            "type": "debugpy",
            "request": "launch",
            "program": "show_images.py",
            "console": "integratedTerminal"
        },
        {
            "name": "train model",
            "type": "debugpy",
            "request": "launch",
            "program": "feed_forward.py",
            "args": ["--epochs", "50", "--save-model", "feed_forward_trained", "--activation", "leaky_relu", "--augment"],
            "console": "integratedTerminal",
        },
        {
            "name": "inference model",
            "type": "debugpy",
            "request": "launch",
            "program": "inference.py",
            "args": ["--model-path", "feed_forward_trained.npy", "--image-path", "trojka.png"],
            "console": "integratedTerminal",
        }
    ]
}